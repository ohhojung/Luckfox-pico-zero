#!/bin/sh
# Prepared for later installation as /etc/init.d/S60heartbeat.
# This script never modifies or brings up WireGuard itself.
BIN=/usr/bin/i1-heartbeat
PIDFILE=/var/run/i1-heartbeat.pid
ENABLED=0
HOST=
PORT=3000
MAC_INTERFACE=eth0
WG_INTERFACE=wg1
[ ! -r /etc/heartbeat.conf ] || . /etc/heartbeat.conf
running() {
    [ -r "$PIDFILE" ] || return 1
    read -r service_pid < "$PIDFILE"
    case "$service_pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$service_pid" -gt 1 ] || return 1
    [ "$(readlink "/proc/$service_pid/exe" 2>/dev/null)" = "$BIN" ] || return 1
    kill -0 "$service_pid" 2>/dev/null
}
case "${1:-}" in
    start)
        if [ "$ENABLED" != 1 ]; then echo 'heartbeat disabled (offline preparation)'; exit 0; fi
        [ -n "$HOST" ] || { echo 'HOST must be set explicitly'; exit 1; }
        [ -x "$BIN" ] || { echo "Missing $BIN"; exit 1; }
        if running; then echo 'heartbeat already running'; exit 0; fi
        "$BIN" --send --host "$HOST" --port "$PORT" \
            --mac-interface "$MAC_INTERFACE" --wg-interface "$WG_INTERFACE" \
            --pidfile "$PIDFILE" --syslog </dev/null >/dev/null 2>&1 &
        sleep 1
        running || { echo 'heartbeat failed to start; check system log'; exit 1; }
        echo 'heartbeat started'
        ;;
    stop)
        if ! running; then echo 'heartbeat not running'; exit 0; fi
        kill -TERM "$service_pid" || exit 1
        tries=0
        while running && [ "$tries" -lt 5 ]; do sleep 1; tries=$((tries+1)); done
        if running; then echo 'heartbeat still running'; exit 1; fi
        echo 'heartbeat stopped'
        ;;
    restart) "$0" stop && "$0" start ;;
    status) if running; then echo "heartbeat running PID=$service_pid"; else echo 'heartbeat stopped'; exit 1; fi ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
