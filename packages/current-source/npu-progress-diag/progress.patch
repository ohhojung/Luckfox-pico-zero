+/* Diagnostic only: preserve each original wait's deadline and completion test.
+ * Only RV1106 single-core synchronous jobs are sampled. No register writes.
+ */
+static bool progress_diag = true;
+module_param(progress_diag, bool, 0644);
+MODULE_PARM_DESC(progress_diag, "Sample slow RV1106 jobs once per second");
+
+static long rknpu_progress_wait(struct rknpu_job *job, int core_index)
+{
+	struct rknpu_device *dev = job->rknpu_dev;
+	struct rknpu_subcore_data *core = &dev->subcore_datas[core_index];
+	unsigned long timeout = msecs_to_jiffies(job->args->timeout);
+	unsigned long deadline = jiffies + timeout;
+	unsigned long remaining = timeout;
+	unsigned long flags;
+	long ret;
+
+	if (!progress_diag || dev->config->pc_task_number_mask != 0xffff ||
+	    dev->config->pc_task_status_offset != 0x3c ||
+	    dev->config->num_irqs != 1)
+		return wait_event_timeout(core->job_done_wq,
+			job->flags & RKNPU_JOB_DONE || dev->soft_reseting, timeout);
+
+	for (;;) {
+		bool active = false;
+		unsigned long now;
+		u32 task = 0, status = 0, raw = 0, mask = 0, required = 0;
+		unsigned long slice = min(remaining, msecs_to_jiffies(1000));
+		ret = wait_event_timeout(core->job_done_wq,
+			job->flags & RKNPU_JOB_DONE || dev->soft_reseting, slice);
+		if (ret)
+			return ret;
+		if (time_after_eq(jiffies, deadline))
+			return 0;
+
+		/* Same irq_lock used for assigning/removing the current job.
+		 * Copy a small snapshot; print after releasing the spinlock.
+		 */
+		spin_lock_irqsave(&dev->irq_lock, flags);
+		if (core->job == job && !dev->soft_reseting &&
+		    !(job->flags & RKNPU_JOB_DONE) && job->commit_pc_time) {
+			void __iomem *base = dev->base[core_index];
+			task = _REG_READ(base, dev->config->pc_task_status_offset);
+			status = _REG_READ(base, RKNPU_OFFSET_INT_STATUS);
+			raw = _REG_READ(base, RKNPU_OFFSET_INT_RAW_STATUS);
+			mask = _REG_READ(base, RKNPU_OFFSET_INT_MASK);
+			required = job->int_mask[core_index];
+			active = true;
+		}
+		spin_unlock_irqrestore(&dev->irq_lock, flags);
+		if (active)
+			LOG_ERROR("NPU_PROGRESS job:%p elapsed_us:%lld task:%u task_reg:%#x irq:%#x raw:%#x mask:%#x required:%#x\n",
+				job, ktime_us_delta(ktime_get(), job->timestamp),
+				task & dev->config->pc_task_number_mask,
+				task, status, raw, mask, required);
+		else
+			LOG_ERROR("NPU_PROGRESS job:%p not_active_or_reset_or_done\n", job);
+		/* Logging time consumes the budget too; never start a fresh 6s wait. */
+		now = jiffies;
+		if (time_after_eq(now, deadline))
+			return 0;
+		remaining = deadline - now;
+	}
+}
